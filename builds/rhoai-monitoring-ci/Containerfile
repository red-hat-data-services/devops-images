ARG PYTHON_IMAGE=docker.io/library/python:3.13-slim-trixie
FROM $PYTHON_IMAGE

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates coreutils curl diffutils findutils gh git grep \
        gzip jq openssh-client sed tar which \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/4.22.18/openshift-client-linux-$(dpkg --print-architecture)-rhel9.tar.gz" -o /tmp/oc.tar.gz \
    && tar -xzf /tmp/oc.tar.gz -C /usr/local/bin oc kubectl \
    && rm /tmp/oc.tar.gz

RUN curl -fsSL "https://github.com/sigstore/cosign/releases/download/v2.4.1/cosign-linux-$(dpkg --print-architecture)" -o /usr/local/bin/cosign \
    && chmod +x /usr/local/bin/cosign

# jq-based yq, matching the filters used by the GitLab jobs.
RUN python -m pip install --no-cache-dir yq==3.4.3

CMD ["/bin/bash"]
